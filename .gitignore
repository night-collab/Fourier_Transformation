# ==========================================
# Python
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so

# 打包与构建产物
build/
dist/
*.egg-info/
.eggs/

# ==========================================
# 虚拟环境
# ==========================================
.venv/
venv/
env/
ENV/

# ==========================================
# Manim 渲染输出
# ==========================================
# media/ 下的视频、图片、Tex 缓存等都是每次运行自动生成的，体积大且变动频繁，默认全部忽略。
media/

# 如果希望把成片（1080p60 等）提交进仓库，把上面的 media/ 换成下面这组「只忽略中间产物」的规则：
# media/videos/*/*/partial_movie_files/
# media/Tex/
# media/texts/
# media/images/

# Manim 全局缓存
.manim/
.manim.cfg.bak

# ==========================================
# 测试与类型检查缓存
# ==========================================
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# ==========================================
# 编辑器 / IDE
# ==========================================
.idea/
*.swp
*.swo

# 保留团队共享的 VSCode 配置，忽略个人设置
.vscode/*
!.vscode/settings.json

# ==========================================
# 操作系统
# ==========================================
.DS_Store
Thumbs.db
desktop.ini

# ==========================================
# 其他
# ==========================================
*.log
